# ==================================================================
# OpenOps AI — Environment Configuration
# Copy this file to `.env`, then fill in your values.
#   cp .env.example .env
# Every value below is optional; default is shown in the comment.
# ==================================================================

# ---- 21st.dev (MCP UI components) ----
# Get a key at https://21st.dev/settings/api-keys
API_KEY_21ST=

# ---- Application ----
APP_NAME=OpenOps AI
APP_VERSION=0.1.0
ENVIRONMENT=development            # development | test | production
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---- Repository (persistence backend) ----
# Use "mongo" for MongoDB / Atlas, "memory" for in-memory (not recommended).
REPOSITORY_TYPE=memory

# ---- MongoDB / Atlas ----
# For Atlas, use: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=openops

# ---- Redis cache (optional; falls back to in-memory if empty) ----
# Local:  redis://localhost:6379/0
# Managed (Redis Cloud): rediss://<user>:<pass>@<host>:<port>
CACHE_URL=

# ---- AI Providers ----
GEMINI_API_KEY=                    # https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=                # https://openrouter.ai/settings/keys
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Embeddings & Knowledge Base ----
EMBEDDING_PROVIDER=hashing          # "hashing" (local) or "gemini"
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
KNOWLEDGE_COLLECTION=knowledge_vectors
VECTOR_SEARCH_INDEX=vector_index
INCIDENT_MEMORY_COLLECTION=incident_memory

# ---- Google ADK bridge (open-source SDK; no account needed) ----
# Pip install it: pip install google-adk
ADK_MODEL=                          # leave empty for SDK default model
ADK_APP_NAME=openops
ADK_SESSION_TIMEOUT_S=30

